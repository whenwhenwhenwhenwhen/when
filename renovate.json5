{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>yuzuyuzuyu/repo-automation:public#v1.0.0",
    ":pinAllExceptPeerDependencies"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "@clammet/**"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:non-major#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:major#v1.0.0"
      ]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-router",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "description": "Attempt major updates automatically after a week; CI must pass before merge"
    },
    {
      "matchPackageNames": [
        "@types/node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "description": "Attempt major updates automatically after a week; CI must pass before merge"
    },
    {
      "matchDepNames": [
        "node"
      ],
      "matchDatasources": [
        "docker",
        "node-version"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "description": "Attempt major updates automatically after a week; CI must pass before merge"
    },
    {
      "matchDepNames": [
        "pnpm"
      ],
      "pinDigests": false
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:action-digest-review#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:renovate-engine#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:node-runtime#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-3-days#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-7-days#v1.0.0"
      ]
    }
  ]
}
