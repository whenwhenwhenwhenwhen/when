{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    "customManagers:githubActionsVersions"
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "rebaseWhen": "behind-base-branch"
  },
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchPackageNames": [
        "@clammet/**"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "dependencyDashboardApproval": false,
      "description": "Attempt major updates automatically after a week; CI must pass before merge"
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-router",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "description": "Attempt major updates automatically after a week; CI must pass before merge"
    },
    {
      "matchPackageNames": [
        "@types/node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "description": "Attempt major updates automatically after a week; CI must pass before merge"
    },
    {
      "matchDepNames": [
        "node"
      ],
      "matchDatasources": [
        "docker",
        "node-version"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": false,
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "description": "Attempt major updates automatically after a week; CI must pass before merge"
    },
    {
      "matchDepNames": [
        "pnpm"
      ],
      "pinDigests": false
    },
    {
      "description": "Never automerge GitHub Actions digest changes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": false
    },
    {
      "description": "Renovate engine: several releases a day, so take the weekly one; no digest pin because the annotated RENOVATE_VERSION env var holds a plain tag",
      "matchDepNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "pinDigests": false
    },
    {
      "description": "Keep Node image, CI runtime, and Node types in one tested PR",
      "matchPackageNames": [
        "node",
        "@types/node"
      ],
      "groupName": "Node runtime"
    },
    {
      "description": "Explain the 3-day release-age gate in PRs after applying package-specific policies",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "matchJsonata": [
        "minimumReleaseAge = '3 days'"
      ],
      "prBodyNotes": [
        "{{#unless isVulnerabilityAlert}}**Release-age gate:** `{{depName}}` requires **3 days** since release (not PR creation). See `renovate/stability-days` for the current status.{{/unless}}",
        "{{#unless isVulnerabilityAlert}}If `renovate/stability-days` is pending, the release-age requirement is unmet or a required release timestamp is unavailable. Renovate rechecks on its scheduled runs; automerge also requires passing checks and an enabled automerge policy. The rebase/retry checkbox is optional and is not an approval request.{{/unless}}"
      ]
    },
    {
      "description": "Explain the 7-day release-age gate in PRs after applying package-specific policies",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "matchJsonata": [
        "minimumReleaseAge = '7 days'"
      ],
      "prBodyNotes": [
        "{{#unless isVulnerabilityAlert}}**Release-age gate:** `{{depName}}` requires **7 days** since release (not PR creation). See `renovate/stability-days` for the current status.{{/unless}}",
        "{{#unless isVulnerabilityAlert}}If `renovate/stability-days` is pending, the release-age requirement is unmet or a required release timestamp is unavailable. Renovate rechecks on its scheduled runs; automerge also requires passing checks and an enabled automerge policy. The rebase/retry checkbox is optional and is not an approval request.{{/unless}}"
      ]
    }
  ],
  "timezone": "Australia/Melbourne",
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 0,
  "description": "Renovate owns dependency updates. Tested updates merge after the release soak; unresolved maintenance is reported by the maintenance workflows. See .github/MAINTENANCE.md.",
  "automergeType": "pr",
  "vulnerabilityAlerts": {
    "automerge": true
  }
}
