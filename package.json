{
  "name": "when",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "concurrently -n convex,vite -c cyan,magenta \"convex dev\" \"vite\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "outdated": "pnpm outdated",
    "preview": "vite preview",
    "convex": "convex dev",
    "convex:deploy": "convex deploy",
    "dev:design": "vite --config vite.config.mock.ts",
    "docker:build": "docker buildx build --platform linux/amd64 -t ghcr.io/whenwhenwhenwhenwhen/when:latest --push .",
    "docker:push": "pnpm docker:build",
    "docker:deploy": "pnpm docker:build"
  },
  "dependencies": {
    "@clammet/convex-googly-auth": "1.0.2",
    "convex": "1.48.0",
    "lucide-react": "1.61.0",
    "luxon": "3.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@testing-library/react": "16.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "convex-test": "0.0.64",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
